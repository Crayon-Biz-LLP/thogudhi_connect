# Copy to `.env` and fill in from your Supabase project
# (Dashboard -> your project -> Settings -> API).
#
# Copy this file to `.env` — never commit `.env` itself.
# `.env` is gitignored; this template is the committed source of truth.

# --- Project (Dashboard -> Settings -> API) ---

# Used server-side only, as a salt when hashing IPs for rate limiting.
SUPABASE_PROJECT_ID="your-project-ref"

# Server-side. The publishable key is safe to expose; the service-role key is NOT.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely and grants full
# read/write on every table and storage bucket. Server-side only, never prefix it
# with VITE_.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Client-side. Vite inlines any VITE_* variable into the browser bundle, so only
# the publishable key belongs here. The code falls back to the unprefixed
# variables above, so these two are what the browser actually reads.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Optional ---

# Only needed if you add a scheduled job that calls authenticateCronRequest()
# in src/integrations/supabase/cron-auth.ts. Not used by the app today.
# LOVABLE_CRON_SECRET="..."
# LOVABLE_CRON_SECRET_PREVIOUS="..."
